/* Source: choppa app/globals.css and dashboard/components/sidebar.css. */
QWidget#choppaShell { background: #0a0a0a; color: #ffffff; font-family: 'Outfit'; font-size: 12px; }
QWidget#choppaSidebar, QWidget#choppaTitlebar { background: #0a0a0a; }
QWidget#choppaShell QLabel { color: #cccccc; background: transparent; border: none; }
QWidget#choppaShell QLabel#brand { color: #ffffff; font-size: 20px; font-weight: 600; }
QWidget#choppaShell QLabel#heading { color: #ffffff; font-size: 13px; font-weight: 500; }
QWidget#choppaShell QLabel#muted { color: #999999; font-size: 12px; }
QWidget#choppaShell QLabel#section { color: #77777d; font-size: 10px; padding: 8px 10px 4px; }
QWidget#choppaShell QPushButton { color: #cccccc; background: #111111; border: 1px solid transparent; border-radius: 6px; padding: 5px 9px; font-family: 'Outfit'; font-size: 12px; text-align: left; }
QWidget#choppaShell QPushButton#account { border: 1px solid #242424; padding: 8px 10px; text-align: left; }
QWidget#choppaShell QPushButton:hover { background: #1a1a1a; color: #ffffff; }
QWidget#choppaShell QPushButton:pressed { background: #242424; }
QWidget#choppaShell QPushButton:focus { border: none; background: #242424; }
QWidget#choppaShell QPushButton:disabled { color: #666666; }
QWidget#choppaShell QPushButton#primary { background: #d6d6d6; color: #0a0a0a; }
QWidget#choppaShell QPushButton#primary:hover { background: #ffffff; }
QWidget#choppaShell QPushButton#nav { background: transparent; }
QWidget#choppaShell QPushButton#nav:hover, QWidget#choppaShell QPushButton#nav:checked { background: #111111; color: #ffffff; }
QWidget#choppaShell QPushButton#windowControl { background: transparent; padding: 0; border: none; border-radius: 6px; text-align: center; }
QWidget#choppaShell QPushButton#windowControl:hover { background: #1a1a1a; }
QWidget#choppaShell QPushButton#closeControl { background: transparent; padding: 0; text-align: center; }
QWidget#choppaShell QPushButton#closeControl:hover { background: #b32d3b; color: white; }
QWidget#choppaShell QLineEdit { background: #111111; border: 1px solid #242424; border-radius: 6px; color: #ffffff; padding: 6px 8px; selection-background-color: #333333; }
QWidget#choppaShell QLineEdit:focus { border-color: #77777d; }
QWidget#choppaShell QListWidget { border: none; outline: none; background: transparent; color: white; }
QWidget#choppaShell QScrollBar:vertical { background: transparent; width: 5px; margin: 0; }
QWidget#choppaShell QScrollBar::handle:vertical { background: #333333; min-height: 28px; border-radius: 2px; }
QWidget#choppaShell QScrollBar::add-line:vertical, QWidget#choppaShell QScrollBar::sub-line:vertical { height: 0; }
QWidget#choppaShell QScrollBar::add-page:vertical, QWidget#choppaShell QScrollBar::sub-page:vertical { background: transparent; }

QMenu { background: #111111; color: #cccccc; border: 1px solid #242424; padding: 6px; }
QMenu::item { padding: 8px 20px; border-radius: 6px; }
QMenu::item:selected { background: #242424; color: white; }
QMenu::separator { height: 1px; background: #242424; margin: 4px 8px; }
